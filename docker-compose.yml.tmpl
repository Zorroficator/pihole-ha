services:
  pihole:
    container_name: pihole-ha
    # Pin to v6: the FTLCONF_* env vars below are v6-only; v5 silently ignores
    # them and would boot a container with no admin password.
    image: pihole/pihole:v6
    hostname: pihole-ha
    # Note: dnsdist runs on port 53 on the Pi-Zero node (see pi_zero/dnsdist.conf) —
    # Pi-hole here has to listen on a different port behind it, hence 5301 instead of 53.
    ports:
      - "<SERVER_IP>:5301:53/tcp"
      - "<SERVER_IP>:5301:53/udp"
      - "<SERVER_IP>:8094:80/tcp"
    environment:
      TZ: "Europe/Berlin"
      FTLCONF_webserver_api_password: "${PIHOLE_API_PASSWORD:?set PIHOLE_API_PASSWORD in .env}"
      FTLCONF_dns_listeningMode: "local"
      FTLCONF_dns_upstreams: "1.1.1.1;9.9.9.9"
    volumes:
      - ./data/etc-pihole:/etc/pihole
      - ./data/etc-dnsmasq.d:/etc/dnsmasq.d
    restart: unless-stopped
