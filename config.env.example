# ─────────────────────────────────────────────────────────────────────────────
# pihole-ha deploy configuration.
#
#   cp config.env.example config.env   &&   $EDITOR config.env   &&   ./render.sh
#
# render.sh replaces every <UPPER_CASE> token in the *.tmpl files with the
# matching value below and writes the deploy-ready file next to each template.
# config.env and the rendered files are gitignored — only *.tmpl is committed.
#
# Values must not contain the '|' character (render.sh uses it as the sed
# delimiter). IPs, subnets, interface names and an 8-char VRRP password are fine.
# ─────────────────────────────────────────────────────────────────────────────

# Virtual IP that floats between the two nodes via VRRP
VIP=192.0.2.10

# IP of the Docker host (the server running Pi-hole in a container)
SERVER_IP=192.0.2.21

# IP of the Raspberry Pi Zero 2W
PIZERO_IP=192.0.2.30

# Tailscale IP of the Pi Zero (used for SSH from the Docker host / dev machine)
PIZERO_TAILSCALE_IP=100.64.0.1

# SSH login user on the Pi Zero (DietPi default is "dietpi")
PI_USER=dietpi

# IP of the keepalived MASTER node on the Docker host (bare metal, or a VM on it)
DNS_HA_VM_IP=192.0.2.22

# SSH target for the server host that runs the Multipass VM (dns-ha).
# Used by dns_ha/deploy.sh to hop into the VM via `multipass exec`.
# A user@host, an IP, or a Tailscale/mDNS hostname all work.
SERVER_SSH_TARGET=user@192.0.2.21

# Multipass instance name of the dns-ha VM (`multipass list`). Used by
# dns_ha/deploy.sh as the `multipass exec <name>` target.
DNS_HA_VM_NAME=dns-ha

# Router IP — last-resort DNS fallback shown in alert messages
ROUTER_IP=192.0.2.1

# Home LAN subnet in CIDR form, for dnsdist ACL / firewall notes
LAN_SUBNET=192.0.2.0/24

# VRRP shared secret. keepalived truncates this to 8 characters and sends it in
# cleartext on the wire — it only rejects a stray VRRP speaker, it is not
# confidentiality. Set an 8-char value from your own password store.
VRRP_AUTH_PASS=changeme8

# Network interface the VIP binds to — Pi Zero side (Pi Zero W: usually wlan0)
IFACE_PI=wlan0

# Network interface the VIP binds to — MASTER node side
IFACE_VM=enp0s2
